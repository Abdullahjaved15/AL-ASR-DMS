{
  "name": "dealership-management-backend",
  "version": "1.0.0",
  "description": "Dealership Management System Express Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "npx prisma generate",
    "postinstall": "npx prisma generate",
    "dev": "nodemon src/server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "db:setup": "prisma generate && prisma db push && node prisma/seed.js",
    "db:import-all": "node prisma/reimportAndAssignAllLeads.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^5.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
