generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  phone           String?
  password        String
  role            String        @default("SALESMAN") // SUPER_ADMIN, ADMIN, SALESMAN
  status          String        @default("PENDING")  // ACTIVE, PENDING, SUSPENDED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdSellers  Seller[]      @relation("CreatedSellers")
  assignedSellers Seller[]      @relation("AssignedSellers")
  createdBuyers   Buyer[]       @relation("CreatedBuyers")
  assignedBuyers  Buyer[]       @relation("AssignedBuyers")
  deals           Deal[]        @relation("UserDeals")
  activities      ActivityLog[]
  invoices        Invoice[]
  receivingLetters ReceivingLetter[]

  primaryCollaborations Collaboration[] @relation("PrimaryCollaborations")
  partnerCollaborations Collaboration[] @relation("PartnerCollaborations")
}

model Seller {
  id               String        @id @default(uuid())
  createdBy        String
  createdByUser    User          @relation("CreatedSellers", fields: [createdBy], references: [id])
  registrationDate DateTime      @default(now())

  vehicle          String?       @default("")
  model            String?       @default("")
  year             String?       @default("")
  color            String?       @default("")
  mileage          Int?          @default(0)

  numberPlate      String?       // Unique Vehicle Registration / License Plate Number
  demandPrice      Float?        @default(0)
  carCondition     String?       @default("Used") // Used, Zero Meter
  zeroMeterType    String?       // Cash, Booking

  sellerName       String?       @default("")
  sellerPhone      String?       @default("")
  sellerCity       String?       @default("")

  leadSource       String?       @default("Direct Call")
  leadReference    String?
  leadReferredBy   String?

  assignedTo       String?
  assignedUser     User?         @relation("AssignedSellers", fields: [assignedTo], references: [id])

  leadStatus       String        @default("New Lead") // New Lead, Contacted, Follow Up, Interested, Negotiation, Deal Closed, Lost, Cancelled, Incomplete
  comments         String?

  variant          String?       @default("")
  transmission     String?       @default("Automatic") // Automatic, Manual
  engineCC         Int?          @default(1300)
  stockStatus      String?       @default("Available") // Available, Reserved, Sold

  images           SellerImage[]
  deals            Deal[]
  collaborations   Collaboration[]
  documents        VehicleDocument[]
  costDetails      UsedCarCostDetail[]
  installmentPlans InstallmentPlan[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([createdAt])
  @@index([leadStatus])
  @@index([assignedTo])
  @@index([vehicle])
  @@index([model])
  @@index([numberPlate])
  @@index([demandPrice])
  @@index([year])
  @@index([assignedTo, leadStatus])
  @@index([assignedTo, createdAt])
  @@index([vehicle, model])
  @@index([leadStatus, createdAt])
}

model SellerImage {
  id                 String   @id @default(uuid())
  sellerId           String
  seller             Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category           String   @default("Other") // Front, Back, Interior, Engine, Dashboard, Documents, Other
  imageUrl           String
  cloudinaryPublicId String?
  uploadedAt         DateTime @default(now())
}

model Buyer {
  id               String   @id @default(uuid())
  createdBy        String
  createdByUser    User     @relation("CreatedBuyers", fields: [createdBy], references: [id])
  registrationDate DateTime @default(now())

  vehicle          String?  @default("")
  model            String?  @default("")
  year             String?  @default("")
  color            String?  @default("")
  mileage          Int?     @default(0)

  budget           Float?   @default(0)
  carCondition     String?  @default("Used") // Used, Zero Meter
  zeroMeterType    String?  // Cash, Booking

  isBankCase       Boolean  @default(false)
  bankName         String?
  bankCaseStatus   String?  @default("Not Confirmed") // Confirmed, Not Confirmed
  bankCaseNo       Int?     // Sequential Case # assigned when confirmed
  bankChecklist    Json?    // Detailed 12-item Bank Case Requirement Checklist
  processingFees   Float?   @default(0)
  downpaymentPercent Float? @default(0)
  downpaymentAmount Float?  @default(0)
  dueAmount        Float?   @default(0)

  buyerName        String?  @default("")
  buyerPhone       String?  @default("")
  buyerCity        String?  @default("")

  leadSource       String?  @default("Website")
  leadReference    String?
  leadReferredBy   String?

  assignedTo       String?
  assignedUser     User?    @relation("AssignedBuyers", fields: [assignedTo], references: [id])

  leadStatus       String   @default("New Lead")
  comments         String?

  deals            Deal[]
  collaborations   Collaboration[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([leadStatus])
  @@index([assignedTo])
  @@index([vehicle])
  @@index([model])
  @@index([isBankCase])
  @@index([budget])
  @@index([year])
  @@index([assignedTo, leadStatus])
  @@index([assignedTo, createdAt])
  @@index([vehicle, model])
  @@index([leadStatus, createdAt])
}

model Invoice {
  id               String   @id @default(uuid())
  invoiceNumber    String   @unique
  category         String   @default("SALES_RECEIPT") // SALES_RECEIPT, DELIVERY_LETTER, PAYMENT_VOUCHER, BOOKING_RECEIPT
  date             DateTime @default(now())
  registrationNo   String?

  // Seller Details (فروخت کنندہ)
  sellerName       String?
  sellerFatherName String?
  sellerCnic       String?
  sellerAddress    String?
  sellerPhone      String?
  sellerPhoto      String?

  // Buyer Details (خریدار)
  buyerName        String?
  buyerFatherName  String?
  buyerCnic       String?
  buyerAddress     String?
  buyerPhone       String?
  buyerPhoto       String?

  // Vehicle Details (گاڑی کی تفصیلات)
  vehicleMaker     String?
  vehicleModel     String?
  engineNumber     String?
  chassisNumber    String?
  powerCapacity    String?
  color            String?
  postOffice       String?
  lastToken        String?
  regName          String?
  regFatherName    String?
  regAddress       String?

  // Transaction Agreement (ٹرانزیکشن معاہدہ)
  agreedAmount     Float?
  agreedAmountHalf Float?
  agreedAmountWords String?
  agreementTime    String?
  agreementDay     String?

  // Additional Voucher Specific Fields (Payment Voucher, Delivery Letter, Booking Receipt)
  payeeName        String?
  headOfAccount    String?
  inWords          String?
  bankStatus       String?
  chequeNo         String?
  dueDate          String?
  onAccount        String?
  accountOf        String?
  time             String?
  cashAmount       String?
  statusBoxNotes   String?

  // Imported Vehicle Details (برائے امپورٹڈ گاڑی)
  isImported       Boolean  @default(false)
  billOfEntryNo    String?
  portName         String?
  clearanceDate    String?
  importerName     String?

  // Financials & Balances
  totalPrice       Float?
  advanceAmount    Float?
  remainingAmount  Float?
  paymentDuration  String?
  dated            String?

  // Legacy / fallback fields
  customerName     String?
  customerPhone    String?
  customerCity     String?
  carVehicle       String?
  carModel         String?
  carYear          String?
  carRegNumber     String?
  saleAmount       Float    @default(0)
  commissionPercent Float   @default(0)
  commissionAmount Float    @default(0)
  totalAmount      Float    @default(0)
  paymentStatus    String   @default("PAID") // PAID, PENDING, CANCELLED
  remarks          String?

  // Witnesses
  witness1Name     String?
  witness1Cnic     String?
  witness2Name     String?
  witness2Cnic     String?

  images           InvoiceImage[]

  createdBy        String
  createdByUser    User     @relation(fields: [createdBy], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([invoiceNumber])
  @@index([category])
  @@index([createdAt])
}

model InvoiceImage {
  id                 String   @id @default(uuid())
  invoiceId          String
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  imageUrl           String
  cloudinaryPublicId String?
  uploadedAt         DateTime @default(now())
}

model Deal {
  id          String   @id @default(uuid())
  buyerId     String?
  buyer       Buyer?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  salesmanId  String
  salesman    User     @relation("UserDeals", fields: [salesmanId], references: [id])

  dealPrice   Float
  profit      Float
  closingDate DateTime @default(now())
  remarks     String?

  createdAt   DateTime @default(now())

  @@index([closingDate])
  @@index([salesmanId])
  @@index([salesmanId, closingDate])
  @@index([closingDate, dealPrice])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Collaboration {
  id                String   @id @default(uuid())
  sellerId          String?
  seller            Seller?  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId           String?
  buyer             Buyer?   @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  primarySalesmanId String
  primarySalesman   User     @relation("PrimaryCollaborations", fields: [primarySalesmanId], references: [id])

  partnerSalesmanId String
  partnerSalesman   User     @relation("PartnerCollaborations", fields: [partnerSalesmanId], references: [id])

  splitPercentage   Float    @default(50.0) // 50-50% commission split
  status            String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([primarySalesmanId])
  @@index([partnerSalesmanId])
  @@index([status])
}

model CurrentStock {
  id            String   @id @default(uuid())
  vehicle       String
  model         String
  year          String
  color         String   @default("White")
  mileage       Int      @default(0)
  askingPrice   Float
  purchasePrice Float?
  status        String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  location      String   @default("Main Showroom")
  notes         String?
  careOf        String?  // Care of / Salesman in charge
  regNumber     String?  // Vehicle Registration / Plate Number
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ReceivingLetter {
  id                String   @id @default(uuid())
  letterNumber      String   @unique
  date              DateTime @default(now())
  vehicleName       String
  chassisNumber     String?
  regNumber         String?
  color             String?
  ownerName         String
  receiverName      String
  fileStatus        String?
  keyStatus         String?
  smartCardStatus   String?
  anyOtherAccessory String?
  notes             String?  // Notes / detail section in the end
  createdBy         String
  createdByUser     User     @relation(fields: [createdBy], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([letterNumber])
  @@index([createdAt])
}

model CentralVault {
  id             String             @id @default(uuid())
  accountName    String             @default("Main Company Vault")
  accountNumber  String             @default("VAULT-001")
  balance        Float              @default(0)
  totalInflow    Float              @default(0)
  totalOutflow   Float              @default(0)
  transactions   VaultTransaction[]
  updatedAt      DateTime           @updatedAt
}

model VaultTransaction {
  id             String        @id @default(uuid())
  vaultId        String?
  vault          CentralVault? @relation(fields: [vaultId], references: [id])
  type           String        // INFLOW, OUTFLOW
  amount         Float
  category       String        // SALE, INSTALLMENT, EXPENSE, REFURBISHMENT, PAYOUT, OTHER
  description    String
  referenceNo    String?
  createdById    String?
  createdAt      DateTime      @default(now())

  @@index([type])
  @@index([createdAt])
}

model Customer {
  id               String            @id @default(uuid())
  customerName     String
  cnic             String?
  phone            String?
  address          String?
  city             String?
  totalPurchases   Int               @default(0)
  totalSpent       Float             @default(0)
  balanceDue       Float             @default(0)
  installmentPlans InstallmentPlan[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([customerName])
  @@index([cnic])
}

model InstallmentPlan {
  id                 String                @id @default(uuid())
  planNumber         String                @unique
  customerId         String
  customer           Customer              @relation(fields: [customerId], references: [id])
  sellerId           String?
  seller             Seller?               @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  vehicleDetails     String
  totalAmount        Float
  downPayment        Float
  financedAmount     Float
  monthlyInstallment Float
  totalInstallments  Int
  paidInstallments   Int                   @default(0)
  status             String                @default("ACTIVE") // ACTIVE, COMPLETED, DEFAULTER
  schedules          InstallmentSchedule[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([planNumber])
  @@index([status])
}

model InstallmentSchedule {
  id            String          @id @default(uuid())
  planId        String
  plan          InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  installmentNo Int
  dueDate       DateTime
  amount        Float
  paidAmount    Float           @default(0)
  paidDate      DateTime?
  status        String          @default("PENDING") // PENDING, PAID, OVERDUE
  remarks       String?

  @@index([dueDate])
  @@index([status])
}

model SecurityCheque {
  id            String   @id @default(uuid())
  chequeNumber  String
  bankName      String
  accountHolder String
  type          String   @default("RECEIVED") // RECEIVED, ISSUED
  amount        Float
  issueDate     DateTime @default(now())
  dueDate       DateTime
  status        String   @default("ISSUED") // ISSUED, CLEARED, BOUNCED, RETURNED
  chequeImage   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([chequeNumber])
  @@index([status])
  @@index([dueDate])
}

model VehicleDocument {
  id           String   @id @default(uuid())
  sellerId     String
  seller       Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  documentType String // Registration Book, Excise File, NOC, Transfer Form, Custom Clearance, Other
  documentName String
  fileUrl      String
  cloudinaryId String?
  uploadedAt   DateTime @default(now())
}

model UsedCarCostDetail {
  id                 String   @id @default(uuid())
  sellerId           String
  seller             Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  previousOwnerName  String?
  previousOwnerPhone String?
  purchasePrice      Float    @default(0)
  refurbishmentCost  Float    @default(0)
  mechanicalRepair   Float    @default(0)
  detailingCost      Float    @default(0)
  otherExpenses      Float    @default(0)
  totalLandedCost    Float    @default(0)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AccountHead {
  id              String               @id @default(uuid())
  accountCode     String               @unique
  accountName     String
  accountType     String               // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  description     String?
  currentBalance  Float                @default(0)
  isSystemAccount Boolean              @default(false)
  transactions    AccountTransaction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([accountType])
  @@index([accountCode])
}

model AccountTransaction {
  id            String      @id @default(uuid())
  accountHeadId String
  accountHead   AccountHead @relation(fields: [accountHeadId], references: [id], onDelete: Cascade)
  type          String      // INWARD, OUTWARD
  amount        Float
  description   String
  referenceNo   String?
  createdById   String?
  createdAt     DateTime    @default(now())

  @@index([type])
  @@index([createdAt])
}
