generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  phone           String?
  password        String
  role            String        @default("SALESMAN") // SUPER_ADMIN, ADMIN, ACCOUNTS_HEAD, ACCOUNTANT, SALESMAN
  status          String        @default("PENDING")  // ACTIVE, PENDING, SUSPENDED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdSellers  Seller[]      @relation("CreatedSellers")
  assignedSellers Seller[]      @relation("AssignedSellers")
  createdBuyers   Buyer[]       @relation("CreatedBuyers")
  assignedBuyers  Buyer[]       @relation("AssignedBuyers")
  deals           Deal[]        @relation("UserDeals")
  activities      ActivityLog[]
  invoices        Invoice[]
  receivingLetters ReceivingLetter[]

  primaryCollaborations Collaboration[] @relation("PrimaryCollaborations")
  partnerCollaborations Collaboration[] @relation("PartnerCollaborations")
  employees       Employee[]
  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  reviewedApprovals  ApprovalRequest[] @relation("ReviewedApprovals")
  incentiveApprovalSheets IncentiveApprovalSheet[]
  
  // Accounts Relations
  createdAccounts        Account[]
  createdTransactions    Transaction[]
  createdCheques         SecurityCheque[]
  createdInstallmentPlans InstallmentPlan[]
}

model Seller {
  id               String        @id @default(uuid())
  createdBy        String
  createdByUser    User          @relation("CreatedSellers", fields: [createdBy], references: [id])
  registrationDate DateTime      @default(now())

  vehicle          String?       @default("")
  model            String?       @default("")
  year             String?       @default("")
  color            String?       @default("")
  mileage          Int?          @default(0)

  numberPlate      String?       // Unique Vehicle Registration / License Plate Number
  demandPrice      String?       @default("")
  carCondition     String?       @default("Used") // Used, Zero Meter
  zeroMeterType    String?       // Cash, Booking
  isCommercial     Boolean       @default(false)
  vehicleType      String?       @default("Personal") // Personal, Commercial

  sellerName       String?       @default("")
  sellerPhone      String?       @default("")
  sellerCity       String?       @default("")

  leadSource       String?       @default("Direct Call")
  leadReference    String?
  leadReferredBy   String?

  assignedTo       String?
  assignedUser     User?         @relation("AssignedSellers", fields: [assignedTo], references: [id])

  leadStatus       String        @default("New Lead") // New Lead, Contacted, Follow Up, Interested, Negotiation, Deal Closed, Lost, Cancelled, Incomplete
  comments         String?

  images           SellerImage[]
  deals            Deal[]
  collaborations   Collaboration[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([createdAt])
  @@index([leadStatus])
  @@index([assignedTo])
  @@index([vehicle])
  @@index([model])
  @@index([numberPlate])
  @@index([demandPrice])
  @@index([year])
  @@index([isCommercial])
  @@index([assignedTo, leadStatus])
  @@index([assignedTo, createdAt])
  @@index([vehicle, model])
  @@index([leadStatus, createdAt])
}

model SellerImage {
  id                 String   @id @default(uuid())
  sellerId           String
  seller             Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category           String   @default("Other") // Front, Back, Interior, Engine, Dashboard, Documents, Other
  imageUrl           String
  cloudinaryPublicId String?
  uploadedAt         DateTime @default(now())
}

model Buyer {
  id               String   @id @default(uuid())
  createdBy        String
  createdByUser    User     @relation("CreatedBuyers", fields: [createdBy], references: [id])
  registrationDate DateTime @default(now())

  vehicle          String?  @default("")
  model            String?  @default("")
  year             String?  @default("")
  color            String?  @default("")
  mileage          Int?     @default(0)

  budget           String?  @default("")
  carCondition     String?  @default("Used") // Used, Zero Meter
  zeroMeterType    String?  // Cash, Booking
  isCommercial     Boolean  @default(false)
  vehicleType      String?  @default("Personal") // Personal, Commercial

  isBankCase       Boolean  @default(false)
  bankName         String?
  bankCaseStatus   String?  @default("Not Confirmed") // Confirmed, Not Confirmed
  bankCaseNo       Int?     // Sequential Case # assigned when confirmed
  bankChecklist    Json?    // Detailed 12-item Bank Case Requirement Checklist
  processingFees   String?  @default("")
  downpaymentPercent String? @default("")
  downpaymentAmount String?  @default("")
  dueAmount        String?  @default("")

  buyerName        String?  @default("")
  buyerPhone       String?  @default("")
  buyerCity        String?  @default("")

  leadSource       String?  @default("Website")
  leadReference    String?
  leadReferredBy   String?

  assignedTo       String?
  assignedUser     User?    @relation("AssignedBuyers", fields: [assignedTo], references: [id])

  leadStatus       String   @default("New Lead")
  comments         String?

  deals            Deal[]
  collaborations   Collaboration[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([leadStatus])
  @@index([assignedTo])
  @@index([vehicle])
  @@index([model])
  @@index([isBankCase])
  @@index([isCommercial])
  @@index([budget])
  @@index([year])
  @@index([assignedTo, leadStatus])
  @@index([assignedTo, createdAt])
  @@index([vehicle, model])
  @@index([leadStatus, createdAt])
}

model Invoice {
  id               String   @id @default(uuid())
  invoiceNumber    String   @unique
  category         String   @default("SALES_RECEIPT") // SALES_RECEIPT, DELIVERY_LETTER, PAYMENT_VOUCHER, BOOKING_RECEIPT
  date             DateTime @default(now())
  registrationNo   String?

  // Seller Details (فروخت کنندہ)
  sellerName       String?
  sellerFatherName String?
  sellerCnic       String?
  sellerAddress    String?
  sellerPhone      String?
  sellerPhoto      String?

  // Buyer Details (خریدار)
  buyerName        String?
  buyerFatherName  String?
  buyerCnic       String?
  buyerAddress     String?
  buyerPhone       String?
  buyerPhoto       String?

  // Vehicle Details (گاڑی کی تفصیلات)
  vehicleMaker     String?
  vehicleModel     String?
  engineNumber     String?
  chassisNumber    String?
  powerCapacity    String?
  color            String?
  postOffice       String?
  lastToken        String?
  regName          String?
  regFatherName    String?
  regAddress       String?

  // Transaction Agreement (ٹرانزیکشن معاہدہ)
  agreedAmount     String?  @default("")
  agreedAmountHalf String?  @default("")
  agreedAmountWords String?
  agreementTime    String?
  agreementDay     String?

  // Additional Voucher Specific Fields (Payment Voucher, Delivery Letter, Booking Receipt)
  payeeName        String?
  headOfAccount    String?
  inWords          String?
  bankStatus       String?
  chequeNo         String?
  dueDate          String?
  onAccount        String?
  accountOf        String?
  time             String?
  cashAmount       String?
  statusBoxNotes   String?

  // Imported Vehicle Details (برائے امپورٹڈ گاڑی)
  isImported       Boolean  @default(false)
  billOfEntryNo    String?
  portName         String?
  clearanceDate    String?
  importerName     String?

  // Financials & Balances
  totalPrice       String?  @default("")
  advanceAmount    String?  @default("")
  remainingAmount  String?  @default("")
  paymentDuration  String?
  dated            String?

  // Legacy / fallback fields
  customerName     String?
  customerPhone    String?
  customerCity     String?
  carVehicle       String?
  carModel         String?
  carYear          String?
  carRegNumber     String?
  saleAmount       String?  @default("")
  commissionPercent String? @default("")
  commissionAmount String?  @default("")
  totalAmount      String?  @default("")
  paymentStatus    String   @default("PAID") // PAID, PENDING, CANCELLED
  remarks          String?

  // Accounts & Payment Mode Fields
  paymentMethod        String?   @default("CASH") // CASH, BANK, SPLIT
  bankAccountId        String?
  cashAmountReceived   String?   @default("")
  bankAmountReceived   String?   @default("")
  isInstallmentSale    Boolean   @default(false)
  installmentPlanId    String?
  deliveryStatus       String    @default("DELIVERED") // DELIVERED, UNDELIVERED, PENDING_SETTLEMENT
  isDoubleSaleLiability Boolean  @default(false)
  linkedChassisSaleId  String?

  // Booking & Sales Receipt Linking Fields
  linkedBookingId      String?   // If this is a Sales Receipt, references the Booking Receipt ID
  linkedBookingNumber  String?   // e.g. BK-20260905-1234
  bookingStatus        String?   @default("ACTIVE") // ACTIVE, CONVERTED_TO_SALE, SETTLED, CANCELLED
  linkedSaleId         String?   // If this is a Booking Receipt, references the created Sales Receipt ID
  linkedSaleNumber     String?   // e.g. REC-20260905-5678
  linkedVoucherId      String?   // If this is a Booking Receipt, references the refund Payment Voucher ID (or vice versa)
  linkedVoucherNumber  String?   // e.g. PV-20260905-5678
  cancellationReason   String?   // Reason for booking cancellation
  cancelledAt          DateTime? // Cancellation timestamp

  // Consignment / Customer-Owned Vehicle Fields & Salesman Attribution
  isCustomerVehicle    Boolean   @default(false)
  salesmanName         String?
  salesmanId           String?
  // Deletion / Archival Status (for converted bookings or soft-deletes)
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  deletedReason        String?

  // Witnesses
  witness1Name     String?
  witness1Cnic     String?
  witness2Name     String?
  witness2Cnic     String?

  images           InvoiceImage[]

  createdBy        String
  createdByUser    User     @relation(fields: [createdBy], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([invoiceNumber])
  @@index([category])
  @@index([createdAt])
  @@index([chassisNumber])
  @@index([deliveryStatus])
  @@index([buyerPhone])
  @@index([linkedBookingId])
  @@index([isCustomerVehicle])
  @@index([isDeleted])
  @@index([salesmanName])
}

model InvoiceImage {
  id                 String   @id @default(uuid())
  invoiceId          String
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  imageUrl           String
  cloudinaryPublicId String?
  uploadedAt         DateTime @default(now())
}

model Deal {
  id          String   @id @default(uuid())
  buyerId     String
  buyer       Buyer    @relation(fields: [buyerId], references: [id])
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id])
  salesmanId  String
  salesman    User     @relation("UserDeals", fields: [salesmanId], references: [id])

  dealPrice   String?  @default("")
  profit      String?  @default("")
  closingDate DateTime @default(now())
  remarks     String?

  createdAt   DateTime @default(now())

  @@index([closingDate])
  @@index([salesmanId])
  @@index([salesmanId, closingDate])
  @@index([closingDate, dealPrice])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Collaboration {
  id                String   @id @default(uuid())
  sellerId          String?
  seller            Seller?  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId           String?
  buyer             Buyer?   @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  primarySalesmanId String
  primarySalesman   User     @relation("PrimaryCollaborations", fields: [primarySalesmanId], references: [id])

  partnerSalesmanId String
  partnerSalesman   User     @relation("PartnerCollaborations", fields: [partnerSalesmanId], references: [id])

  splitPercentage   Float    @default(50.0) // 50-50% commission split
  status            String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([primarySalesmanId])
  @@index([partnerSalesmanId])
  @@index([status])
}

model CurrentStock {
  id            String   @id @default(uuid())
  vehicle       String
  model         String
  year          String
  color         String   @default("White")
  mileage       Int      @default(0)
  askingPrice   String?  @default("")
  purchasePrice String?  @default("")
  status        String   @default("AVAILABLE") // AVAILABLE, RESERVED, AT_CUSTOMER, SOLD
  location      String   @default("Main Showroom")
  notes         String?
  careOf        String?  // Care of / Salesman in charge
  regNumber     String?  // Vehicle Registration / Plate Number
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AccountsStock {
  id            String   @id @default(uuid())
  vehicle       String
  model         String
  year          String
  color         String   @default("White")
  mileage       Int      @default(0)
  askingPrice   String?  @default("")
  purchasePrice String?  @default("")
  status        String   @default("AVAILABLE") // AVAILABLE, RESERVED, AT_CUSTOMER, SOLD
  location      String   @default("Main Showroom")
  notes         String?
  careOf        String?  // Care of / In-charge
  regNumber     String?  // Vehicle Registration / Plate Number
  chassisNumber String?  // Vehicle Chassis Number
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ReceivingLetter {
  id                String   @id @default(uuid())
  letterNumber      String   @unique
  date              DateTime @default(now())
  receivingTime     String?  // Time of receiving vehicle (e.g. 11:30 AM)
  vehicleName       String
  modelYear         String?  // Model / Year of vehicle (e.g. 2022, 2024)
  chassisNumber     String?
  regNumber         String?
  color             String?
  mileage           String?  // Vehicle Mileage (e.g. 45,000 km)
  demandAmount      String?  // Vehicle Demand Amount (PKR)
  fullFinalAmount   String?  // Backward compatibility alias for demand
  ownerName         String
  receiverName      String
  fileStatus        String?
  keyStatus         String?
  smartCardStatus   String?
  anyOtherAccessory String?
  notes             String?  // Notes / detail section in the end
  createdBy         String
  createdByUser     User     @relation(fields: [createdBy], references: [id])
  images            ReceivingLetterImage[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([letterNumber])
  @@index([createdAt])
}

model ReceivingLetterImage {
  id                 String          @id @default(uuid())
  receivingLetterId  String
  receivingLetter    ReceivingLetter @relation(fields: [receivingLetterId], references: [id], onDelete: Cascade)
  imageUrl           String
  cloudinaryPublicId String?
  uploadedAt         DateTime        @default(now())
}

model Employee {
  id          String       @id @default(uuid())
  name        String
  designation String?      @default("Sales Executive")
  phone       String?
  email       String?
  department  String?      @default("Sales")
  status      String       @default("ACTIVE") // ACTIVE, INACTIVE
  userId      String?      // Optional link to system User if available
  user        User?        @relation(fields: [userId], references: [id])
  attendances Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime  // Stores the date of attendance (00:00:00 UTC)
  checkIn    String?   // Format e.g., "09:00 AM" or "09:00"
  checkOut   String?   // Format e.g., "06:00 PM" or "18:00"
  status     String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LATE, LEAVE
  totalHours Float?    @default(0)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, date])
}

model ApprovalRequest {
  id              String    @id @default(uuid())
  entityType      String    // SELLER, BUYER, CURRENT_STOCK, RECEIVING_LETTER, CASH_BOOK
  entityId        String    // ID of the record being edited/deleted
  entityName      String?   // Friendly summary name e.g. "Toyota Fortuner 2022 (Plate ATG-081)"
  action          String    // EDIT, DELETE
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  
  requestedById   String
  requestedByUser User      @relation("RequestedApprovals", fields: [requestedById], references: [id], onDelete: Cascade)
  
  proposedData    Json?     // New fields for EDIT
  currentData     Json?     // Snapshot before modification
  reason          String?   // Admin reason / note
  
  reviewedById    String?
  reviewedByUser  User?     @relation("ReviewedApprovals", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes     String?   // Super admin notes
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?

  @@index([status])
  @@index([entityType])
  @@index([requestedById])
}

model IncentiveApprovalSheet {
  id                    String   @id @default(uuid())
  sheetNumber           String   @unique
  
  // Row 1: Date
  dateCol1              String?  @default("")
  dateCol2              String?  @default("")
  
  // Row 2: Vehicle + REG#
  vehicleRegCol1        String?  @default("")
  vehicleRegCol2        String?  @default("")
  
  // Row 3: Ch#
  chassisNoCol1         String?  @default("")
  chassisNoCol2         String?  @default("")
  
  // Row 4: Color
  colorCol1             String?  @default("")
  colorCol2             String?  @default("")
  
  // Row 5: Model
  modelCol1             String?  @default("")
  modelCol2             String?  @default("")
  
  // Row 6: Purchaser Name/Number
  purchaserCol1         String?  @default("")
  purchaserCol2         String?  @default("")
  
  // Row 7: Seller Name/Number
  sellerCol1            String?  @default("")
  sellerCol2            String?  @default("")
  
  // Row 8: Personal Contact
  personalContactCol1   String?  @default("")
  personalContactCol2   String?  @default("")
  
  // Row 9: Social Media
  socialMediaCol1       String?  @default("")
  socialMediaCol2       String?  @default("")
  
  // Row 10: Walking Customer
  walkingCustomerCol1   String?  @default("")
  walkingCustomerCol2   String?  @default("")
  
  // Row 11: Visiting Customer
  visitingCustomerCol1  String?  @default("")
  visitingCustomerCol2  String?  @default("")
  
  // Row 12: Other
  otherCol1             String?  @default("")
  otherCol2             String?  @default("")
  
  // Row 13: Cash/Bank
  cashBankCol1          String?  @default("")
  cashBankCol2          String?  @default("")
  
  // Row 14: Sale Person/Name Sign
  salePersonSignCol1    String?  @default("")
  salePersonSignCol2    String?  @default("")
  
  // Row 15: Deal
  dealCol1              String?  @default("")
  dealCol2              String?  @default("")
  
  // Row 16: Amount
  amountCol1            String?  @default("")
  amountCol2            String?  @default("")
  
  // Row 17: Commision/ % Or Fee
  commissionCol1        String?  @default("")
  commissionCol2        String?  @default("")
  
  // Row 18: Location
  locationCol1          String?  @default("")
  locationCol2          String?  @default("")
  
  // Row 19: Bio Status
  bioStatusCol1         String?  @default("")
  bioStatusCol2         String?  @default("")
  
  // Row 20: Approved By
  approvedByCol1        String?  @default("")
  approvedByCol2        String?  @default("")

  createdBy             String
  createdByUser         User     @relation(fields: [createdBy], references: [id])
  images                IncentiveApprovalSheetImage[]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([sheetNumber])
  @@index([createdAt])
}

model IncentiveApprovalSheetImage {
  id                    String                 @id @default(uuid())
  sheetId               String
  sheet                 IncentiveApprovalSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  imageUrl              String
  cloudinaryPublicId    String?
  uploadedAt            DateTime               @default(now())
}

// ==========================================
// ACCOUNTS & FINANCIAL MANAGEMENT MODELS
// ==========================================

model Account {
  id             String             @id @default(uuid())
  code           String             @unique
  name           String
  type           String             // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  subType        String?            // CASH, BANK, CUSTOMER, VENDOR, EXPENSE, CAPITAL, OTHER
  bankName       String?
  accountNumber  String?
  branch         String?
  openingBalance Float              @default(0)
  currentBalance Float              @default(0)
  description    String?
  isActive       Boolean            @default(true)
  isSystem       Boolean            @default(false)

  createdBy      String?
  createdByUser  User?              @relation(fields: [createdBy], references: [id])

  entries        TransactionEntry[]
  securityCheques SecurityCheque[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([code])
  @@index([type])
  @@index([subType])
}

model Transaction {
  id                String             @id @default(uuid())
  transactionNumber String             @unique
  date              DateTime           @default(now())
  type              String             // PAYMENT_VOUCHER, RECEIPT_VOUCHER, SALES_INVOICE, FUNDS_TRANSFER, INSTALLMENT_PAYMENT, SECURITY_CHEQUE_CLEARANCE, JOURNAL
  amount            Float
  description       String
  referenceType     String?            // INVOICE, INSTALLMENT, CHEQUE, TRANSFER, STOCK, MANUAL
  referenceId       String?
  referenceNumber   String?
  chassisNumber     String?

  createdById       String
  createdByUser     User               @relation(fields: [createdById], references: [id])

  entries           TransactionEntry[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([transactionNumber])
  @@index([date])
  @@index([type])
  @@index([chassisNumber])
  @@index([referenceNumber])
}

model TransactionEntry {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id])
  
  type          String      // DEBIT, CREDIT
  amount        Float
  description   String?

  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([accountId])
  @@index([type])
}

model SecurityCheque {
  id            String    @id @default(uuid())
  chequeNumber  String
  type          String    @default("ISSUED") // ISSUED (Given by Al-Asr), RECEIVED (Taken from customer)
  
  bankAccountId String?
  bankAccount   Account?  @relation(fields: [bankAccountId], references: [id])
  
  bankName      String    // Name of the bank (e.g. Meezan Bank)
  partyName     String    // Payee / Party / Supplier / Customer
  partyPhone    String?
  partyCnic     String?
  
  amount        Float
  issueDate     DateTime  @default(now())
  dueDate       DateTime  // Maturity date
  status        String    @default("ISSUED") // ISSUED, PRESENTED, CLEARED, BOUNCED, CANCELLED, RETURNED
  clearedAt     DateTime?
  
  transactionId String?
  chassisNumber String?
  notes         String?

  createdById   String
  createdByUser User      @relation(fields: [createdById], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([chequeNumber])
  @@index([status])
  @@index([type])
  @@index([dueDate])
  @@index([chassisNumber])
}

model InstallmentPlan {
  id                 String            @id @default(uuid())
  planNumber         String            @unique
  invoiceId          String?
  
  customerName       String
  customerPhone      String?
  customerCnic       String?
  customerAddress    String?
  
  vehicleName        String
  registrationNo     String?
  chassisNumber      String?
  
  totalPrice         Float
  advanceAmount      Float
  remainingAmount    Float
  totalInstallments  Int
  installmentAmount  Float
  frequency          String            @default("MONTHLY") // MONTHLY, QUARTERLY, CUSTOM
  startDate          DateTime
  status             String            @default("ACTIVE") // ACTIVE, COMPLETED, OVERDUE, CANCELLED
  notes              String?

  items              InstallmentItem[]

  createdById        String
  createdByUser      User              @relation(fields: [createdById], references: [id])

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([planNumber])
  @@index([status])
  @@index([customerName])
  @@index([chassisNumber])
}

model InstallmentItem {
  id                String          @id @default(uuid())
  planId            String
  plan              InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  installmentNumber Int
  dueDate           DateTime
  amount            Float
  paidAmount        Float           @default(0)
  paidDate          DateTime?
  
  paymentMethod     String?         // CASH, BANK, SPLIT
  bankAccountId     String?
  receiptNumber     String?
  status            String          @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  
  transactionId     String?
  notes             String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([planId])
  @@index([dueDate])
  @@index([status])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String?
  targetRole  String?  @default("ACCOUNTS_HEAD") // ACCOUNTS_HEAD, SUPER_ADMIN, ALL
  title       String
  message     String
  type        String   @default("FINANCIAL_INFLOW") // SALES_RECEIPT, BOOKING_RECEIPT, FINANCIAL_INFLOW, BUYBACK
  category    String?  // CASH, BANK, SPLIT
  amount      Float?
  referenceId String?  // e.g. invoice id
  isRead      Boolean  @default(false)
  readBy      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetRole])
  @@index([isRead])
  @@index([createdAt])
}



