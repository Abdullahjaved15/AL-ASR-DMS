generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  phone           String?
  password        String
  role            String        @default("SALESMAN") // SUPER_ADMIN, ADMIN, SALESMAN
  status          String        @default("PENDING")  // ACTIVE, PENDING, SUSPENDED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdSellers  Seller[]      @relation("CreatedSellers")
  assignedSellers Seller[]      @relation("AssignedSellers")
  createdBuyers   Buyer[]       @relation("CreatedBuyers")
  assignedBuyers  Buyer[]       @relation("AssignedBuyers")
  deals           Deal[]        @relation("UserDeals")
  activities      ActivityLog[]
  invoices        Invoice[]
  receivingLetters ReceivingLetter[]

  primaryCollaborations Collaboration[] @relation("PrimaryCollaborations")
  partnerCollaborations Collaboration[] @relation("PartnerCollaborations")
}

model Seller {
  id               String        @id @default(uuid())
  createdBy        String
  createdByUser    User          @relation("CreatedSellers", fields: [createdBy], references: [id])
  registrationDate DateTime      @default(now())

  vehicle          String
  model            String
  year             Int
  color            String
  mileage          Int

  numberPlate      String?       // Unique Vehicle Registration / License Plate Number
  demandPrice      Float
  carCondition     String?       @default("Used") // Used, Zero Meter
  zeroMeterType    String?       // Cash, Booking

  sellerName       String
  sellerPhone      String
  sellerCity       String

  leadSource       String
  leadReference    String?

  assignedTo       String?
  assignedUser     User?         @relation("AssignedSellers", fields: [assignedTo], references: [id])

  leadStatus       String        @default("New Lead") // New Lead, Contacted, Follow Up, Interested, Negotiation, Deal Closed, Lost, Cancelled, Incomplete
  comments         String?

  images           SellerImage[]
  deals            Deal[]
  collaborations   Collaboration[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([createdAt])
  @@index([leadStatus])
  @@index([assignedTo])
  @@index([vehicle])
  @@index([model])
  @@index([numberPlate])
  @@index([demandPrice])
  @@index([year])
  @@index([assignedTo, leadStatus])
  @@index([assignedTo, createdAt])
  @@index([vehicle, model])
  @@index([leadStatus, createdAt])
}

model SellerImage {
  id                 String   @id @default(uuid())
  sellerId           String
  seller             Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category           String   @default("Other") // Front, Back, Interior, Engine, Dashboard, Documents, Other
  imageUrl           String
  cloudinaryPublicId String?
  uploadedAt         DateTime @default(now())
}

model Buyer {
  id               String   @id @default(uuid())
  createdBy        String
  createdByUser    User     @relation("CreatedBuyers", fields: [createdBy], references: [id])
  registrationDate DateTime @default(now())

  vehicle          String
  model            String
  year             Int
  color            String
  mileage          Int

  budget           Float
  carCondition     String?  @default("Used") // Used, Zero Meter
  zeroMeterType    String?  // Cash, Booking

  isBankCase       Boolean  @default(false)
  bankName         String?
  bankChecklist    Json?    // Detailed 12-item Bank Case Requirement Checklist
  processingFees   Float?   @default(0)
  downpaymentPercent Float? @default(0)
  downpaymentAmount Float?  @default(0)
  dueAmount        Float?   @default(0)

  buyerName        String
  buyerPhone       String
  buyerCity        String

  leadSource       String
  leadReference    String?

  assignedTo       String?
  assignedUser     User?    @relation("AssignedBuyers", fields: [assignedTo], references: [id])

  leadStatus       String   @default("New Lead")
  comments         String?

  deals            Deal[]
  collaborations   Collaboration[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([leadStatus])
  @@index([assignedTo])
  @@index([vehicle])
  @@index([model])
  @@index([isBankCase])
  @@index([budget])
  @@index([year])
  @@index([assignedTo, leadStatus])
  @@index([assignedTo, createdAt])
  @@index([vehicle, model])
  @@index([leadStatus, createdAt])
}

model Invoice {
  id               String   @id @default(uuid())
  invoiceNumber    String   @unique
  date             DateTime @default(now())
  registrationNo   String?

  // Seller Details (فروخت کنندہ)
  sellerName       String?
  sellerFatherName String?
  sellerAddress    String?
  sellerPhone      String?

  // Buyer Details (خریدار)
  buyerName        String?
  buyerFatherName  String?
  buyerAddress     String?
  buyerPhone       String?

  // Vehicle Details (گاڑی کی تفصیلات)
  vehicleMaker     String?
  vehicleModel     String?
  engineNumber     String?
  chassisNumber    String?
  powerCapacity    String?
  postOffice       String?
  lastToken        String?
  regName          String?
  regFatherName    String?
  regAddress       String?

  // Transaction Agreement (ٹرانزیکشن معاہدہ)
  agreedAmount     Float?
  agreedAmountHalf Float?
  agreedAmountWords String?
  agreementTime    String?
  agreementDay     String?

  // Imported Vehicle Details (برائے امپورٹڈ گاڑی)
  isImported       Boolean  @default(false)
  billOfEntryNo    String?
  portName         String?
  clearanceDate    String?
  importerName     String?

  // Financials & Balances
  totalPrice       Float?
  advanceAmount    Float?
  remainingAmount  Float?
  paymentDuration  String?
  dated            String?

  // Legacy / fallback fields
  customerName     String?
  customerPhone    String?
  customerCity     String?
  carVehicle       String?
  carModel         String?
  carYear          Int?
  carRegNumber     String?
  saleAmount       Float    @default(0)
  commissionPercent Float   @default(0)
  commissionAmount Float    @default(0)
  totalAmount      Float    @default(0)
  paymentStatus    String   @default("PAID") // PAID, PENDING, CANCELLED
  remarks          String?

  // Witnesses
  witness1Name     String?
  witness1Cnic     String?
  witness2Name     String?
  witness2Cnic     String?

  createdBy        String
  createdByUser    User     @relation(fields: [createdBy], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([invoiceNumber])
  @@index([createdAt])
}

model Deal {
  id          String   @id @default(uuid())
  buyerId     String
  buyer       Buyer    @relation(fields: [buyerId], references: [id])
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id])
  salesmanId  String
  salesman    User     @relation("UserDeals", fields: [salesmanId], references: [id])

  dealPrice   Float
  profit      Float
  closingDate DateTime @default(now())
  remarks     String?

  createdAt   DateTime @default(now())

  @@index([closingDate])
  @@index([salesmanId])
  @@index([salesmanId, closingDate])
  @@index([closingDate, dealPrice])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Collaboration {
  id                String   @id @default(uuid())
  sellerId          String?
  seller            Seller?  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId           String?
  buyer             Buyer?   @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  primarySalesmanId String
  primarySalesman   User     @relation("PrimaryCollaborations", fields: [primarySalesmanId], references: [id])

  partnerSalesmanId String
  partnerSalesman   User     @relation("PartnerCollaborations", fields: [partnerSalesmanId], references: [id])

  splitPercentage   Float    @default(50.0) // 50-50% commission split
  status            String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([primarySalesmanId])
  @@index([partnerSalesmanId])
  @@index([status])
}

model CurrentStock {
  id            String   @id @default(uuid())
  vehicle       String
  model         String
  year          Int
  color         String   @default("White")
  mileage       Int      @default(0)
  askingPrice   Float
  purchasePrice Float?
  status        String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  location      String   @default("Main Showroom")
  notes         String?
  careOf        String?  // Care of / Salesman in charge
  regNumber     String?  // Vehicle Registration / Plate Number
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ReceivingLetter {
  id                String   @id @default(uuid())
  letterNumber      String   @unique
  date              DateTime @default(now())
  vehicleName       String
  chassisNumber     String?
  regNumber         String?
  color             String?
  ownerName         String
  receiverName      String
  fileStatus        String?
  keyStatus         String?
  smartCardStatus   String?
  anyOtherAccessory String?
  notes             String?  // Notes / detail section in the end
  createdBy         String
  createdByUser     User     @relation(fields: [createdBy], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([letterNumber])
  @@index([createdAt])
}
